/**
 * 全局样式
 */
page {
  background: #F8FBFF;
  font-size: 28rpx;
  color: #172033;
}

.btn-primary {
  background: #3478F6;
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  box-shadow: 0 8rpx 20rpx rgba(52, 120, 246, 0.22);
}

.btn-danger {
  background: #e74c3c;
  color: #fff;
  border-radius: 12rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  margin: 20rpx;
  padding: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(23, 32, 51, 0.05);
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #fff;
}

.tag-open { background: #27ae60; }
.tag-in_progress { background: #f39c12; }
.tag-reviewing { background: #8e44ad; }
.tag-settled { background: #16a085; }
.tag-expired { background: #95a5a6; }
.tag-cancelled { background: #e74c3c; }
.tag-claimed { background: #f39c12; }
.tag-submitted { background: #8e44ad; }
.tag-approved { background: #27ae60; }
.tag-rejected { background: #e74c3c; }

.empty {
  text-align: center;
  color: #94A3B8;
  padding: 80rpx 0;
  font-size: 26rpx;
}

/* ══════════════════════════════════════════════════════════
   设计 token（Design Tokens）
   - 放在全局 app.wxss：所有页面自动继承，无需 @import（避免跨目录引用问题）
   - 使用：var(--tb-primary, #3478F6)  ← 带兜底值，老基础库可降级
   ══════════════════════════════════════════════════════════ */
page {
  /* 品牌色 */
  --tb-primary: #3478F6;
  --tb-primary-2: #4C8DFF;
  --tb-primary-deep: #2B5FCC;
  --tb-primary-soft: #EBF2FF;
  --tb-primary-border: #D6E4FF;
  /* 中性色 */
  --tb-bg: #F8FBFF;
  --tb-surface: #FFFFFF;
  --tb-text: #172033;
  --tb-text-sub: #64748B;
  --tb-text-muted: #9AA6BA;
  --tb-border: #E5EAF2;
  /* 语义色 */
  --tb-success: #07C160;
  --tb-danger: #E74C3C;
  /* 圆角 */
  --tb-radius-sm: 20rpx;
  --tb-radius-md: 28rpx;
  --tb-radius-lg: 32rpx;
  /* 间距 */
  --tb-gap-xs: 12rpx;
  --tb-gap-sm: 24rpx;
  --tb-gap-md: 40rpx;
  --tb-gap-lg: 60rpx;
  /* 字号 */
  --tb-fs-xs: 22rpx;
  --tb-fs-sm: 25rpx;
  --tb-fs-md: 28rpx;
  --tb-fs-lg: 34rpx;
  --tb-fs-xl: 38rpx;
  /* 阴影 */
  --tb-shadow-primary: 0 28rpx 60rpx rgba(52, 120, 246, 0.32);
  --tb-shadow-card: 0 16rpx 40rpx rgba(23, 32, 51, 0.05);
}
