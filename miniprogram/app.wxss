/**
 * 全局样式
 */
page {
  background: #F8FBFF;
  font-size: 28rpx;
  color: #172033;
}

.btn-primary {
  background: #3478F6;
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  box-shadow: 0 8rpx 20rpx rgba(52, 120, 246, 0.22);
}

.btn-danger {
  background: #e74c3c;
  color: #fff;
  border-radius: 12rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  margin: 20rpx;
  padding: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(23, 32, 51, 0.05);
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #fff;
}

.tag-open { background: #27ae60; }
.tag-in_progress { background: #f39c12; }
.tag-reviewing { background: #8e44ad; }
.tag-settled { background: #16a085; }
.tag-expired { background: #95a5a6; }
.tag-cancelled { background: #e74c3c; }
.tag-claimed { background: #f39c12; }
.tag-submitted { background: #8e44ad; }
.tag-approved { background: #27ae60; }
.tag-rejected { background: #e74c3c; }

.empty {
  text-align: center;
  color: #94A3B8;
  padding: 80rpx 0;
  font-size: 26rpx;
}