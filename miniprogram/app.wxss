/**
 * 全局样式
 */
page {
  background: #f5f6fa;
  font-size: 28rpx;
  color: #333;
}

.btn-primary {
  background: #4A90D9;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.btn-danger {
  background: #e74c3c;
  color: #fff;
  border-radius: 12rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #fff;
}

.tag-open { background: #27ae60; }
.tag-in_progress { background: #f39c12; }
.tag-reviewing { background: #8e44ad; }
.tag-settled { background: #16a085; }
.tag-expired { background: #95a5a6; }
.tag-cancelled { background: #e74c3c; }
.tag-claimed { background: #f39c12; }
.tag-submitted { background: #8e44ad; }
.tag-approved { background: #27ae60; }
.tag-rejected { background: #e74c3c; }

.empty {
  text-align: center;
  color: #999;
  padding: 80rpx 0;
  font-size: 26rpx;
}