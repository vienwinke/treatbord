.page {
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding-bottom: 120rpx;   /* 给固定底栏留出空间 */
  background: #F8FBFF;
}

/* ══ 个人信息区 ══ */
.profile {
  display: flex;
  align-items: center;
  padding: 60rpx 40rpx 50rpx;
  color: #fff;
  background: linear-gradient(135deg, #3478F6, #66B3FF);
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.profile-info { flex: 1; min-width: 0; }

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 10rpx;
}

/* ══ 我的订单概览 ══ */
.orders {
  background: #fff;
  border-radius: 24rpx;
  margin: 24rpx 24rpx 0;
  padding: 28rpx 24rpx 10rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.orders-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.orders-title { font-size: 32rpx; font-weight: bold; }

.orders-all { font-size: 26rpx; color: #94A3B8; }

.stat-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 10rpx;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-icon { font-size: 36rpx; }

.stat-name { font-size: 22rpx; color: #64748B; margin-top: 8rpx; }

.stat-count {
  font-size: 20rpx;
  color: #3478F6;
  margin-top: 4rpx;
}

/* ══ 功能区：常用功能 ══ */
.func-card {
  background: #fff;
  border-radius: 24rpx;
  margin: 24rpx 24rpx 0;
  padding: 8rpx 0 4rpx;
  box-shadow: 0 6rpx 20rpx rgba(23, 32, 51, 0.05);
}
.func-title {
  font-size: 24rpx;
  color: #94A3B8;
  padding: 16rpx 28rpx 8rpx;
}
.func-item {
  display: flex;
  align-items: center;
  padding: 22rpx 28rpx;
}
.func-item + .func-item { border-top: 1rpx solid #EEF2F8; }
.func-ic {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: #EDF4FF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.func-name { flex: 1; font-size: 28rpx; color: #172033; }
.func-badge {
  font-size: 20rpx;
  color: #fff;
  background: #E5484D;
  border-radius: 18rpx;
  padding: 2rpx 12rpx;
  margin-right: 12rpx;
}
.func-arrow { font-size: 28rpx; color: #C7D2E0; }

/* ══ 订单列表 ══ */
.tabs {
  display: flex;
  background: #fff;
  margin: 24rpx 0 0;
  border-bottom: 1rpx solid #eee;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  border-bottom: 4rpx solid transparent;
}

.tab-active { color: #3478F6; font-weight: bold; border-bottom-color: #3478F6; }

.claim-item { margin-bottom: 0; }

.claim-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.claim-title { font-size: 30rpx; font-weight: bold; flex: 1; }

.claim-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #888;
}

.claim-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
}

/* ══ 固定底部：版本号 ══ */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #F8FBFF;
  padding-top: 16rpx;
  padding-bottom: 30rpx;
  text-align: center;
}

.footer {
  font-size: 22rpx;
  color: #b8bcc6;
}