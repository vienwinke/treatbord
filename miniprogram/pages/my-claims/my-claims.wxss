.page {
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding-bottom: 120rpx;   /* 给固定底栏留出空间 */
  background: #f5f6fa;
}

/* ══ 个人信息区 ══ */
.profile {
  display: flex;
  align-items: center;
  padding: 60rpx 40rpx 50rpx;
  color: #fff;
  background: linear-gradient(135deg, #4A90D9, #6bb3f0);
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.profile-info { flex: 1; min-width: 0; }

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 10rpx;
}

/* ══ 我的订单概览 ══ */
.orders {
  background: #fff;
  border-radius: 24rpx;
  margin: 32rpx 24rpx 0;
  padding: 28rpx 24rpx 10rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.orders-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.orders-title { font-size: 32rpx; font-weight: bold; }

.orders-all { font-size: 26rpx; color: #999; }

.stat-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 10rpx;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-icon { font-size: 36rpx; }

.stat-name { font-size: 22rpx; color: #555; margin-top: 8rpx; }

.stat-count {
  font-size: 20rpx;
  color: #4A90D9;
  margin-top: 4rpx;
}

/* ══ 订单列表 ══ */
.tabs {
  display: flex;
  background: #fff;
  margin: 24rpx 0 0;
  border-bottom: 1rpx solid #eee;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  border-bottom: 4rpx solid transparent;
}

.tab-active { color: #4A90D9; font-weight: bold; border-bottom-color: #4A90D9; }

.claim-item { margin-bottom: 0; }

.claim-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.claim-title { font-size: 30rpx; font-weight: bold; flex: 1; }

.claim-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #888;
}

.claim-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
}

/* ══ 固定底部：版本号 ══ */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #f5f6fa;
  padding-top: 16rpx;
  padding-bottom: 30rpx;
  text-align: center;
}

.footer {
  font-size: 22rpx;
  color: #b8bcc6;
}