<view class="page">

  <!-- ══ 个人信息区（未登录点击 → 跳登录） ══ -->
  <view class="profile" bindtap="onTapProfile">
    <view class="avatar">{{isLogin ? nickname0 : '?'}}</view>
    <view class="profile-info">
      <view class="nickname">{{isLogin ? nickname : '未登录'}}</view>
      <view class="sub">
        {{isLogin ? '信用分 ' + creditScore : '登录后查看我的订单'}}
      </view>
    </view>
  </view>

  <!-- ══ 我的订单概览 ══ -->
  <view class="orders">
    <view class="orders-head">
      <text class="orders-title">我的订单</text>
      <text class="orders-all" bindtap="goAllOrders">全部 ›</text>
    </view>
    <view class="stat-row">
      <view class="stat" bindtap="goOrders" data-status="DOING">
        <view class="stat-icon">⏳</view>
        <view class="stat-name">进行中</view>
        <view class="stat-count">{{stats.doing}}</view>
      </view>
      <view class="stat" bindtap="goOrders" data-status="CONFIRM">
        <view class="stat-icon">🔍</view>
        <view class="stat-name">待确认</view>
        <view class="stat-count">{{stats.confirm}}</view>
      </view>
      <view class="stat" bindtap="goOrders" data-status="DONE">
        <view class="stat-icon">✅</view>
        <view class="stat-name">已完成</view>
        <view class="stat-count">{{stats.done}}</view>
      </view>
      <view class="stat" bindtap="goOrders" data-status="CLOSED">
        <view class="stat-icon">🚫</view>
        <view class="stat-name">已关闭</view>
        <view class="stat-count">{{stats.closed}}</view>
      </view>
    </view>
  </view>

  <!-- ══ 功能区：常用功能 ══ -->
  <view class="func-card">
    <view class="func-title">常用功能</view>
    <view class="func-item" bindtap="goNotifications">
      <view class="func-ic">🔔</view>
      <text class="func-name">消息通知</text>
      <text wx:if="{{unread > 0}}" class="func-badge">{{unread}}</text>
      <text class="func-arrow">›</text>
    </view>
    <view class="func-item" bindtap="goPublished">
      <view class="func-ic">📤</view>
      <text class="func-name">我的发布</text>
      <text class="func-arrow">›</text>
    </view>
    <view class="func-item" bindtap="goReport">
      <view class="func-ic">🚩</view>
      <text class="func-name">举报与反馈</text>
      <text class="func-arrow">›</text>
    </view>
    <view class="func-item" bindtap="goCredit">
      <view class="func-ic">⭐</view>
      <text class="func-name">信用与评价</text>
      <text class="func-arrow">›</text>
    </view>
    <view wx:if="{{isAdmin}}" class="func-item" bindtap="goAdmin">
      <view class="func-ic">🛡</view>
      <text class="func-name">管理后台</text>
      <text class="func-arrow">›</text>
    </view>
    <view class="func-item" bindtap="goHelp">
      <view class="func-ic">💬</view>
      <text class="func-name">帮助与反馈</text>
      <text class="func-arrow">›</text>
    </view>
    <view class="func-item" bindtap="goCredentials">
      <view class="func-ic">🔐</view>
      <text class="func-name">设置账号密码</text>
      <text class="func-arrow">›</text>
    </view>
  </view>

  <!-- ══ 订单列表（我接取的 / 我发布的） ══ -->
  <view class="tabs">
    <view class="tab {{tab === 'claims' ? 'tab-active' : ''}}" data-tab="claims" bindtap="switchTab">
      我接取的
    </view>
    <view class="tab {{tab === 'published' ? 'tab-active' : ''}}" data-tab="published" bindtap="switchTab">
      我发布的
    </view>
  </view>

  <!-- 我接取的 -->
  <block wx:if="{{tab === 'claims'}}">
    <view wx:if="{{!isLogin}}" class="empty">登录后可查看我的接取订单</view>
    <view wx:elif="{{!visibles.length && !loading}}" class="empty">
      {{orderFilter ? '该状态下暂无订单' : '还没有接取任务，去大厅逛逛吧'}}
    </view>
    <view class="card claim-item" wx:for="{{visibles}}" wx:key="id">
      <view class="claim-head">
        <text class="claim-title">{{item.taskTitle}}</text>
        <text class="tag {{item.tagClass}}">{{item.claimStatusText}}</text>
      </view>
      <view class="claim-meta">
        <text>报酬 ¥{{item.reward}}</text>
        <text>任务状态：{{item.taskStatusText}}</text>
      </view>
      <view class="claim-actions">
        <button size="mini" bindtap="goTask" data-taskid="{{item.taskId}}">详情</button>
        <button wx:if="{{item.status === 'CLAIMED'}}" size="mini" type="warn" plain
                data-id="{{item.id}}" bindtap="doCancelClaim">取消</button>
        <button wx:if="{{item.status === 'CLAIMED'}}" size="mini" type="primary"
                data-taskid="{{item.taskId}}" bindtap="goSubmit">提交凭证</button>
        <button wx:if="{{item.status === 'APPROVED'}}" size="mini" type="primary" plain
                data-claimid="{{item.id}}" data-taskid="{{item.taskId}}" bindtap="goPeerReview">互评</button>
      </view>
    </view>
  </block>

  <!-- 我发布的 -->
  <block wx:if="{{tab === 'published'}}">
    <view wx:if="{{!isLogin}}" class="empty">登录后可查看我发布的任务</view>
    <view wx:elif="{{!myTasks.length && !loading}}" class="empty">还没发布过任务</view>
    <view class="card claim-item" wx:for="{{myTasks}}" wx:key="id">
      <view class="claim-head">
        <text class="claim-title">{{item.title}}</text>
        <text class="tag {{item.tagClass}}">{{item.statusText}}</text>
      </view>
      <view class="claim-meta">
        <text>报酬 ¥{{item.reward}}</text>
        <text>接取 {{item.claimedCount}}/{{item.quota}}</text>
      </view>
      <view class="claim-actions">
        <button size="mini" bindtap="goTask" data-taskid="{{item.id}}">详情</button>
        <button wx:if="{{item.status === 'IN_PROGRESS'}}" size="mini" type="primary"
                data-taskid="{{item.id}}" bindtap="goReview">审核</button>
      </view>
    </view>
  </block>

  <view wx:if="{{loading}}" class="empty">加载中...</view>

  <!-- ══ 底部版本号 ══ -->
  <view class="bottom-bar">
    <view class="footer">v0.1.1 · Treatbord</view>
  </view>
</view>