.page {
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding-bottom: 180rpx;      /* 给固定底栏留出空间，避免遮挡订单卡片 */
  background: #f5f6fa;         /* 页面其余区域统一浅灰 */
}

/* ══ 个人信息区（蓝色专属） ══ */
.profile {
  display: flex;
  align-items: center;
  padding: 80rpx 40rpx 60rpx;
  color: #fff;
  background: linear-gradient(135deg, #4A90D9, #6bb3f0);
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  font-size: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.profile-info { flex: 1; min-width: 0; }

.nickname {
  font-size: 38rpx;
  font-weight: bold;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 10rpx;
}

/* ══ 我的订单 ══ */
.orders {
  background: #fff;
  border-radius: 24rpx;
  margin: 40rpx 24rpx 0;
  padding: 30rpx 24rpx 10rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.orders-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.orders-title { font-size: 32rpx; font-weight: bold; }

.orders-all { font-size: 26rpx; color: #999; }

.stat-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 10rpx;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-icon { font-size: 36rpx; }

.stat-name { font-size: 22rpx; color: #555; margin-top: 8rpx; }

.stat-count {
  font-size: 20rpx;
  color: #4A90D9;
  margin-top: 4rpx;
}

/* ══ 固定底部：版本号 ══ */
.bottom-bar {
  position: fixed;          /* 固定定位：始终钉在屏幕最底部 */
  left: 0;
  right: 0;
  bottom: 0;
  background: #f5f6fa;      /* 与页面底色一致，遮住滚动内容 */
  padding-top: 16rpx;
  padding-bottom: 30rpx;
  text-align: center;
}

.footer {
  text-align: center;
  font-size: 22rpx;
  color: #b8bcc6;
}