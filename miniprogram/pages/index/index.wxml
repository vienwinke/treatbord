<view class="page">

  <!-- ══ 搜索 ══ -->
  <view class="search">
    <view class="search-box">
      <view class="mag"></view>
      <input class="search-input" placeholder="搜索任务关键词" placeholder-class="ph"
             value="{{keyword}}" bindinput="onSearchInput"
             confirm-type="search" bindconfirm="onSearch" />
      <view wx:if="{{keyword}}" class="clear" bindtap="onClearKeyword">×</view>
    </view>
    <view class="search-btn" bindtap="onSearch">搜索</view>
  </view>

  <!-- ══ 状态筛选（保留全部 5 个状态；窄屏可横向滑动）══ -->
  <scroll-view class="seg-wrap" scroll-x enable-flex show-scrollbar="{{false}}">
    <view class="seg">
      <view wx:for="{{statusOptions}}" wx:key="value"
            class="seg-item {{currentStatus === item.value ? 'seg-on' : ''}}"
            data-value="{{item.value}}" bindtap="onStatusTap">{{item.label}}</view>
    </view>
  </scroll-view>

  <!-- ══ 空态 ══ -->
  <view wx:if="{{!tasks.length && !loading && !firstLoad}}" class="empty">
    <view class="empty-icon">📭</view>
    <view class="empty-title">{{emptyText}}</view>
    <view class="empty-sub">换个关键字或状态试试</view>
  </view>

  <!-- ══ 任务列表（赏金优先：左侧赏金块 + 右侧信息 + 名额进度条）══ -->
  <view class="rows">
    <view class="row" wx:for="{{tasks}}" wx:key="id"
          data-id="{{item.id}}" bindtap="goDetail" hover-class="row-hover">
      <view class="bounty">
        <view class="bounty-val"><text class="sym">¥</text>{{item.rewardText}}</view>
        <view class="bounty-sub">{{item.quota}} 个名额</view>
      </view>
      <view class="info">
        <view class="row-title">{{item.title}}</view>
        <view class="meta">
          <text class="tag {{item.tagClass}}">{{item.statusText}}</text>
          <text class="meta-text">已接 {{item.claimedCount}}/{{item.quota}}</text>
        </view>
        <view class="bar">
          <view class="bar-in {{item.isFull ? 'bar-full' : ''}}" style="width: {{item.progressPercent}}%"></view>
        </view>
        <view class="sub">接取截止 {{item.claimDeadlineText}} · {{item.publisherNickname}}</view>
      </view>
      <view wx:if="{{item.isFull}}" class="full-flag">已满</view>
    </view>
  </view>

  <!-- ══ 加载 / 到底 ══ -->
  <view wx:if="{{loading}}" class="loading-tip">加载中...</view>
  <view wx:if="{{!hasMore && tasks.length && !loading}}" class="list-end">— 没有更多了 —</view>
</view>
