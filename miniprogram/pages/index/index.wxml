<view class="search-bar">
  <input class="search-input" placeholder="搜索任务关键词" value="{{keyword}}" bindinput="onSearchInput" confirm-type="search" bindconfirm="onSearch" />
  <view class="search-btn" bindtap="onSearch">搜索</view>
</view>

<view class="status-tabs">
  <view wx:for="{{statusOptions}}" wx:key="value"
        class="tab {{currentStatus === item.value ? 'tab-active' : ''}}"
        data-value="{{item.value}}" bindtap="onStatusTap">
    {{item.label}}
  </view>
</view>

<view wx:if="{{!tasks.length && !loading && !firstLoad}}" class="empty">暂无任务</view>

<view class="task-list">
  <view class="card task-item" wx:for="{{tasks}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
    <view class="task-title">
      <text class="title-text">{{item.title}}</text>
      <text class="tag {{item.tagClass}}">{{item.statusText}}</text>
    </view>
    <view class="task-meta">
      <text class="reward">¥{{item.reward}}</text>
      <text class="meta">已接 {{item.claimedCount}}/{{item.quota}}</text>
    </view>
    <view class="task-footer">
      <text>接取截止 {{item.claimDeadline}}</text>
      <text>发布者：{{item.publisherNickname}}</text>
    </view>
  </view>
</view>

<view wx:if="{{loading}}" class="empty">加载中...</view>
<view wx:if="{{!hasMore && tasks.length && !loading}}" class="empty">没有更多了</view>