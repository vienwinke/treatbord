/* 任务大厅（设计 token 见 app.wxss） */
.page {
  min-height: 100vh;
  background: var(--tb-bg, #F8FBFF);
  padding-bottom: 40rpx;
}

/* ══ 搜索 ══ */
.search { display: flex; align-items: center; padding: 16rpx 40rpx 0; }
.search-box {
  flex: 1; height: 76rpx; background: var(--tb-surface, #fff);
  border: 2rpx solid var(--tb-border, #E5EAF2); border-radius: 24rpx;
  display: flex; align-items: center; padding: 0 24rpx;
}
.mag {
  width: 28rpx; height: 28rpx; flex: 0 0 28rpx; margin-right: 16rpx;
  border: 4rpx solid #C3CAD6; border-radius: 50%; position: relative;
}
.mag::after {
  content: ""; position: absolute; right: -8rpx; bottom: -6rpx;
  width: 12rpx; height: 4rpx; background: #C3CAD6; transform: rotate(45deg);
}
.search-input { flex: 1; font-size: 27rpx; color: var(--tb-text, #172033); }
.ph { color: #C3CAD6; }
.clear {
  width: 40rpx; height: 40rpx; line-height: 36rpx; text-align: center;
  color: #C3CAD6; font-size: 32rpx;
}
.search-btn {
  margin-left: 20rpx; font-size: 27rpx; font-weight: 600;
  color: var(--tb-primary, #3478F6);
}

/* ══ 状态筛选 ══ */
.seg-wrap { width: 100%; white-space: nowrap; padding: 22rpx 0 6rpx; }
.seg {
  display: inline-flex; background: #EDF1F7; border-radius: 24rpx;
  padding: 6rpx; margin: 0 40rpx;
}
.seg-item {
  flex: 0 0 auto; min-width: 120rpx; text-align: center;
  font-size: 25rpx; color: var(--tb-text-sub, #64748B);
  padding: 14rpx 20rpx; border-radius: 18rpx;
}
.seg-on {
  background: var(--tb-surface, #fff); color: var(--tb-primary, #3478F6);
  font-weight: 600; box-shadow: 0 8rpx 20rpx rgba(23, 32, 51, 0.08);
}

/* ══ 列表 ══ */
.rows { padding: 18rpx 40rpx 0; }
.row {
  display: flex; position: relative; background: var(--tb-surface, #fff);
  border-radius: 28rpx; margin-bottom: 20rpx; overflow: hidden;
  box-shadow: 0 12rpx 32rpx rgba(23, 32, 51, 0.05);
}
.row-hover { opacity: 0.9; }

/* 左侧赏金块 */
.bounty {
  flex: 0 0 200rpx; display: flex; flex-direction: column;
  align-items: center; justify-content: center; padding: 28rpx 12rpx;
  background: linear-gradient(160deg, #F2F7FF, #E7F0FF);
}
.bounty-val {
  font-size: 40rpx; font-weight: 800; color: #F2542D; letter-spacing: -1rpx;
  line-height: 1.1;
}
.bounty-val .sym { font-size: 24rpx; font-weight: 600; }
.bounty-sub { font-size: 21rpx; color: var(--tb-text-muted, #9AA6BA); margin-top: 6rpx; }

/* 右侧信息 */
.info { flex: 1; min-width: 0; padding: 24rpx 28rpx; }
.row-title {
  font-size: 29rpx; font-weight: 600; color: var(--tb-text, #172033);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.meta { display: flex; align-items: center; margin-top: 14rpx; }
.meta-text { font-size: 23rpx; color: var(--tb-text-muted, #9AA6BA); margin-left: 14rpx; }
.bar {
  height: 10rpx; border-radius: 6rpx; background: #EDF1F7;
  margin-top: 14rpx; overflow: hidden;
}
.bar-in {
  height: 10rpx; border-radius: 6rpx;
  background: linear-gradient(90deg, #3478F6, #66B3FF);
}
.bar-full { background: #C3CAD6; }
.sub {
  font-size: 22rpx; color: #B4BDCC; margin-top: 12rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.full-flag {
  position: absolute; right: 0; top: 0; font-size: 20rpx; color: #D93A2B;
  background: #FDECEA; padding: 6rpx 16rpx; border-bottom-left-radius: 16rpx;
}

/* ══ 状态/空态 ══ */
.empty { text-align: center; padding: 140rpx 0 0; }
.empty-icon { font-size: 76rpx; }
.empty-title { font-size: 29rpx; color: var(--tb-text-sub, #64748B); margin-top: 20rpx; }
.empty-sub { font-size: 24rpx; color: #B4BDCC; margin-top: 10rpx; }
.loading-tip { text-align: center; font-size: 24rpx; color: #B4BDCC; padding: 24rpx 0; }
.list-end { text-align: center; font-size: 24rpx; color: #B4BDCC; padding: 20rpx 0 40rpx; }
