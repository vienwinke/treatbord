<view class="head-bar">
  <text class="head-title">通知（{{total}}）</text>
  <text class="read-all" bindtap="readAll">全部已读</text>
</view>

<view wx:if="{{!list.length && !loading}}" class="empty">暂无通知</view>

<view class="card noti-item {{item.unreadClass}}" wx:for="{{list}}" wx:key="id"
      data-id="{{item.id}}" data-biz="{{item.bizId}}" data-read="{{item.isRead}}"
      bindtap="goDetail">
  <view class="noti-icon">{{item.typeIcon}}</view>
  <view class="noti-body">
    <view class="noti-head">
      <text class="noti-type">{{item.typeText}}</text>
      <text class="noti-time">{{item.timeText}}</text>
    </view>
    <view class="noti-title">{{item.title}}</view>
    <view class="noti-content">{{item.content}}</view>
  </view>
  <view wx:if="{{item.isRead === 0}}" class="dot"></view>
</view>

<view wx:if="{{loading}}" class="empty">加载中...</view>