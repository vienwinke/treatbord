.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 32rpx 48rpx;
  background: #F8FBFF;
}

.tip {
  font-size: 24rpx;
  color: #94A3B8;
  line-height: 1.6;
  margin-bottom: 28rpx;
}

.item {
  background: #FFFFFF;
  border: 2rpx solid #E5EAF2;
  border-radius: 20rpx;
  padding: 8rpx 28rpx;
  margin-bottom: 24rpx;
}
.label { font-size: 24rpx; color: #94A3B8; margin-top: 16rpx; }
.input {
  width: 100%;
  box-sizing: border-box;
  height: 76rpx;
  font-size: 30rpx;
  color: #172033;
}
.ph { color: #94A3B8; }

.save {
  margin-top: 40rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  background: linear-gradient(135deg, #3478F6 0%, #66B3FF 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 20rpx;
  border: none;
}
.save::after { border: none; }