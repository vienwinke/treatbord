<view class="page">
  <view class="doc-header">
    <view class="doc-title">用户协议</view>
    <view class="doc-meta">生效日期：{{updatedAt}}</view>
  </view>

  <view class="card" wx:for="{{sections}}" wx:key="title">
    <view class="section-title">{{item.title}}</view>
    <view class="para" wx:for="{{item.paragraphs}}" wx:for-item="p" wx:key="*this">{{p}}</view>
  </view>

  <view class="footer-link" bindtap="openPrivacy">查看《隐私政策》</view>
  <view class="footer-tip">请在使用本平台前仔细阅读并理解以上条款</view>
</view>