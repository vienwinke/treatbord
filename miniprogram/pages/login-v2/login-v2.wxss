/* ══════════════════════════════════════════════════
   Treatbord 登录页（login-v2）
   设计规范：375×812 · iOS HIG · 1px = 2rpx
   ─ 背景 #F8FBFF / 主色 #3478F6 / 辅助蓝 #66B3FF
   ─ 标题 #172033 / 正文 #64748B / 辅助 #94A3B8 / 分割线 #E5EAF2
   ══════════════════════════════════════════════════ */
page {
  background: #F8FBFF;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 48rpx;               /* 页面水平边距 24px */
  background: #F8FBFF;
  display: flex;
  flex-direction: column;
}

/* ══ Header（高约 52px = 104rpx） ══ */
.header-wrap {
  margin: 0 -48rpx;               /* 通栏，抵消页面边距 */
  background: #F8FBFF;
}
.header {
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #E5EAF2;   /* 分割线 */
}
.nav-back {
  width: 96rpx;
  height: 88rpx;
  margin-left: 8rpx;
  flex-shrink: 0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.back-hover { opacity: 0.55; }
.back-chevron {
  width: 22rpx;
  height: 22rpx;
  border-left: 4rpx solid #3478F6;
  border-bottom: 4rpx solid #3478F6;
  transform: rotate(45deg);
}
.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #172033;
}
.nav-space {
  width: 96rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

/* ══ Brand（垂直居中：Logo / Treatbord / 任务服务中心） ══ */
.hero {
  flex: 1;
  min-height: 340rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.logo {
  position: relative;
  width: 144rpx;                  /* 72px */
  height: 144rpx;
  border-radius: 48rpx;           /* 24px */
  background: linear-gradient(135deg, #3478F6 0%, #66B3FF 100%);
  box-shadow: 0 24rpx 56rpx rgba(52, 120, 246, 0.30);
}
.logo-ring {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 60rpx;
  height: 60rpx;
  margin: -40rpx 0 0 -40rpx;      /* 外沿 80rpx，居中 */
  border: 10rpx solid rgba(255, 255, 255, 0.98);
  border-radius: 50%;
}
.logo-dot {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 20rpx;
  height: 20rpx;
  margin: -10rpx 0 0 -10rpx;
  background: #FFFFFF;
  border-radius: 50%;
}
.app-name {
  margin-top: 32rpx;
  font-size: 60rpx;               /* 30px */
  font-weight: 700;
  color: #172033;
  letter-spacing: 6rpx;
}
.app-sub {
  margin-top: 16rpx;
  font-size: 28rpx;               /* 14px */
  color: #64748B;
  letter-spacing: 4rpx;
}

/* ══ Feature Row（三列等宽） ══ */
.features {
  display: flex;
  margin-bottom: 88rpx;
}
.feature {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.feature-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;           /* 功能图标 14px */
  background: #FFFFFF;            /* 白色卡片 */
  box-shadow: 0 8rpx 24rpx rgba(23, 32, 51, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}
.feature-name {
  margin-top: 20rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #64748B;
  letter-spacing: 2rpx;
}
.feature-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #94A3B8;
}

/* ══ Login CTA ══ */
.cta-row {
  margin: 0 -48rpx;               /* 通栏，按钮相对全屏宽度计算 */
}
.login-btn {
  display: block;
  width: calc(100% - 48px);       /* 按钮宽度规范 */
  height: 112rpx;                 /* 56px */
  margin: 0 auto;                 /* 两侧各留 24px */
  border-radius: 36rpx;           /* 18px */
  background: linear-gradient(135deg, #3478F6 0%, #66B3FF 100%);
  color: #FFFFFF;
  border: none;
  padding: 0;
  box-shadow: 0 12rpx 28rpx rgba(52, 120, 246, 0.22);   /* 非常轻微阴影 */
}
.login-btn::after { border: none; }
.login-inner {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.login-text {
  font-size: 36rpx;               /* 18px */
  font-weight: 600;
  line-height: 56rpx;
  letter-spacing: 2rpx;
}
/* 微信图标（双气泡，纯 CSS 绘制） */
.wx-mark {
  position: relative;
  width: 48rpx;
  height: 40rpx;
  margin-right: 20rpx;
}
.wx-bubble {
  position: absolute;
  width: 26rpx;
  height: 26rpx;
  background: #FFFFFF;
  border-radius: 30% 30% 30% 10%;
  transform: rotate(45deg);
}
.wx-bubble-a { left: 0; top: 0; }
.wx-bubble-b { right: 0; bottom: 0; }

/* ══ Login Hint ══ */
.login-hint {
  margin-top: 28rpx;
  text-align: center;
  font-size: 22rpx;
  color: #94A3B8;
  letter-spacing: 1rpx;
}

/* ══ Agreement ══ */
.agreement {
  margin-top: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.checkbox {
  width: 28rpx;                   /* 14px */
  height: 28rpx;
  border-radius: 16rpx;           /* 复选框 8px */
  border: 2rpx solid #C7D2E8;
  background: #FFFFFF;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  transition: all 0.2s;
}
.checkbox-on {
  background: #3478F6;
  border-color: #3478F6;
}
.check-mark {
  width: 12rpx;
  height: 7rpx;
  border-left: 3rpx solid #FFFFFF;
  border-bottom: 3rpx solid #FFFFFF;
  transform: rotate(-45deg);
  margin-top: -4rpx;
  opacity: 0;
  transition: opacity 0.2s;
}
.check-mark.show { opacity: 1; }
.agree-text {
  font-size: 22rpx;
  color: #64748B;
}
.agree-link {
  color: #3478F6;
  padding: 0 2rpx;
}

/* ══ Version ══ */
.version {
  margin-top: 72rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  text-align: center;
  font-size: 20rpx;
  color: #94A3B8;
  letter-spacing: 2rpx;
}

/* ══ 其他登录方式 ══ */
.other-divider {
  display: flex;
  align-items: center;
  margin-top: 40rpx;
  color: #94A3B8;
  font-size: 24rpx;
}
.other-divider::before,
.other-divider::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: #E5EAF2;
}
.other-divider text { margin: 0 24rpx; }
.other-btn {
  margin-top: 28rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border: 2rpx solid #E5EAF2;
  border-radius: 20rpx;
  font-size: 30rpx;
  color: #172033;
}
.other-ic { font-size: 32rpx; margin-right: 10rpx; }
.other-text { font-size: 30rpx; }

/* ══ 账密登录 ══ */
.acc-back {
  margin-top: 24rpx;
  color: #3478F6;
  font-size: 26rpx;
  padding: 12rpx 0;
}
.acc-item {
  margin-top: 24rpx;
  background: #FFFFFF;
  border: 2rpx solid #E5EAF2;
  border-radius: 20rpx;
  padding: 8rpx 28rpx;
}
.acc-label { font-size: 24rpx; color: #94A3B8; margin-top: 16rpx; }
.acc-input {
  width: 100%;
  box-sizing: border-box;
  height: 72rpx;
  font-size: 30rpx;
  color: #172033;
}
.acc-ph { color: #94A3B8; }
.acc-login {
  margin-top: 40rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  background: linear-gradient(135deg, #3478F6 0%, #66B3FF 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 20rpx;
  border: none;
}
.acc-login::after { border: none; }
.acc-tip {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #94A3B8;
  line-height: 1.5;
}