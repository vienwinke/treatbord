.page {
  min-height: 100vh;
  background: var(--tb-bg, #F8FBFF);
  display: flex;
  flex-direction: column;
}

/* ══ 导航栏 ══ */
.header-wrap { background: transparent; }
.header { height: 88rpx; display: flex; align-items: center; position: relative; }
.nav-back {
  position: absolute; left: 24rpx; width: 60rpx; height: 60rpx;
  display: flex; align-items: center; justify-content: center;
}
.back-chevron {
  width: 22rpx; height: 22rpx;
  border-left: 4rpx solid var(--tb-text, #172033);
  border-bottom: 4rpx solid var(--tb-text, #172033);
  border-radius: 2rpx; transform: rotate(45deg);
}
.back-hover { opacity: 0.55; }
.nav-title {
  flex: 1; text-align: center; font-size: var(--tb-fs-lg, 34rpx);
  font-weight: 600; color: var(--tb-text, #172033);
}
.nav-space { width: 60rpx; }

/* ══ 上下文提示条 ══ */
.ctx {
  margin: 16rpx 40rpx 0; padding: 22rpx 28rpx;
  background: var(--tb-primary-soft, #EBF2FF);
  border: 1rpx solid var(--tb-primary-border, #D6E4FF);
  border-radius: var(--tb-radius-md, 28rpx);
  display: flex; align-items: center;
}
.ctx-ic {
  width: 40rpx; height: 40rpx; flex: 0 0 40rpx; margin-right: 16rpx;
  border-radius: 14rpx; background: var(--tb-primary, #3478F6);
  color: #fff; font-size: 24rpx; line-height: 40rpx; text-align: center;
}
.ctx-text { font-size: 26rpx; color: var(--tb-primary-deep, #2B5FCC); }

/* ══ 内容区：占满剩余高度并垂直居中（margin:auto 不会被裁切） ══ */
.content { flex: 1; display: flex; flex-direction: column; }
.content-inner { margin: auto 0; width: 100%; padding: 24rpx 0; }

/* ══ 品牌（紧凑） ══ */
.brand { text-align: center; margin-top: 0; }
.logo {
  width: 120rpx; height: 120rpx; margin: 0 auto; border-radius: 40rpx;
  background: linear-gradient(135deg, #3478F6, #66B3FF);
  box-shadow: 0 24rpx 52rpx rgba(52, 120, 246, 0.3);
  display: flex; align-items: center; justify-content: center;
}
.logo-ring { width: 44rpx; height: 44rpx; border: 8rpx solid #fff; border-radius: 16rpx; }
.brand-name {
  margin-top: 24rpx; font-size: var(--tb-fs-xl, 38rpx);
  font-weight: 700; letter-spacing: 1rpx; color: var(--tb-text, #172033);
}
.brand-sub { margin-top: 10rpx; font-size: var(--tb-fs-sm, 25rpx); color: var(--tb-text-muted, #9AA6BA); }

/* ══ 按钮 ══ */
.tb-btn {
  height: 104rpx; border-radius: var(--tb-radius-lg, 32rpx);
  display: flex; align-items: center; justify-content: center;
  font-size: var(--tb-fs-lg, 34rpx); font-weight: 600;
  overflow: hidden;
}
/* 微信 button 自带 ::after 边框，需显式去掉，否则圆角外会多一层描边 */
.tb-btn::after { border: none; }
.tb-btn-primary {
  background: linear-gradient(135deg, var(--tb-primary, #3478F6), var(--tb-primary-2, #4C8DFF));
  color: #fff; border: none;
  box-shadow: var(--tb-shadow-primary, 0 28rpx 60rpx rgba(52, 120, 246, 0.32));
}
.tb-btn-ghost {
  background: var(--tb-surface, #fff); color: var(--tb-primary, #3478F6);
  border: 3rpx solid var(--tb-primary-border, #D6E4FF);
}
.btn-hover { opacity: 0.86; }
.btn-inner { display: flex; align-items: center; }
.wx-mark { position: relative; width: 40rpx; height: 34rpx; margin-right: 16rpx; }
.wx-bubble { position: absolute; background: rgba(255, 255, 255, 0.92); border-radius: 50%; }
.wx-bubble-a { width: 26rpx; height: 26rpx; top: 0; left: 0; }
.wx-bubble-b { width: 20rpx; height: 20rpx; bottom: 0; right: 0; opacity: 0.85; }

/* ══ 主体 ══ */
.main { padding: 60rpx 48rpx 0; }
.hint { margin-top: 24rpx; font-size: 24rpx; color: var(--tb-text-muted, #9AA6BA); text-align: center; }
.tb-divider {
  display: flex; align-items: center; margin: 52rpx 0 32rpx;
  font-size: 24rpx; color: var(--tb-text-muted, #9AA6BA);
}
.tb-divider::before, .tb-divider::after { content: ""; flex: 1; height: 1rpx; background: var(--tb-border, #E5EAF2); }
.tb-divider text { padding: 0 24rpx; }

/* ══ 账密模式 ══ */
.acc-back { margin: 44rpx 48rpx 0; font-size: 27rpx; color: var(--tb-primary, #3478F6); }
.tb-field { margin: 16rpx 48rpx 0; padding: 28rpx 0 20rpx; border-bottom: 1rpx solid #E9EEF6; }
.tb-label { font-size: 23rpx; color: var(--tb-text-muted, #9AA6BA); letter-spacing: 1rpx; }
.tb-input { margin-top: 16rpx; font-size: 32rpx; color: var(--tb-text, #172033); width: 100%; }
.tb-input-row { display: flex; align-items: center; }
.tb-input-row .tb-input { flex: 1; width: auto; }
.tb-eye {
  flex: 0 0 auto; margin-left: 20rpx; padding: 8rpx 0 0;
  font-size: 24rpx; color: var(--tb-text-muted, #9AA6BA);
}
.tb-ph { color: #C3CAD6; }
.acc-submit { margin: 56rpx 48rpx 0; }
.acc-tip {
  margin: 36rpx 48rpx 0; padding: 26rpx 28rpx; background: var(--tb-surface, #fff);
  border: 1rpx solid #EDF1F7; border-radius: var(--tb-radius-md, 28rpx);
  font-size: 24rpx; line-height: 1.7; color: var(--tb-text-sub, #64748B);
}
.acc-tip-link { color: var(--tb-primary, #3478F6); }

/* ══ 协议 ══ */
.foot {
  padding: 40rpx 48rpx 48rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  text-align: center;
}
.foot-row {
  display: flex; align-items: center; justify-content: center; flex-wrap: wrap;
  font-size: 25rpx; color: var(--tb-text-sub, #64748B); line-height: 1.8;
}
.checkbox {
  width: 32rpx; height: 32rpx; flex: 0 0 32rpx; margin-right: 14rpx;
  border-radius: 10rpx; border: 2rpx solid var(--tb-primary, #3478F6);
  display: flex; align-items: center; justify-content: center;
}
.checkbox-on { background: var(--tb-primary, #3478F6); }
.check-mark {
  width: 14rpx; height: 8rpx; border-left: 3rpx solid #fff; border-bottom: 3rpx solid #fff;
  transform: rotate(-45deg) translate(1rpx, -2rpx); opacity: 0;
}
.check-mark.show { opacity: 1; }
.foot-text { color: var(--tb-text-sub, #64748B); }
.foot-link { color: var(--tb-primary, #3478F6); }
.version { margin-top: 18rpx; font-size: var(--tb-fs-xs, 22rpx); color: #B4BDCC; }
