.wrapper { padding-bottom: 40rpx; }

.header {
  background: linear-gradient(135deg, #4A90D9, #6bb3f0);
  color: #fff;
  padding: 40rpx 30rpx;
}

.title-row { display: flex; align-items: center; justify-content: space-between; }

.title { font-size: 40rpx; font-weight: bold; line-height: 1.4; }

.reward { font-size: 52rpx; font-weight: bold; margin-top: 20rpx; }

.meta { font-size: 24rpx; opacity: 0.85; margin-top: 10rpx; }

.row { display: flex; justify-content: space-between; padding: 14rpx 0; border-bottom: 1rpx solid #f0f0f0; }

.label { color: #999; }

.section-title { font-size: 30rpx; font-weight: bold; margin-bottom: 16rpx; }

.desc { font-size: 28rpx; color: #555; line-height: 1.6; }

.actions { margin: 40rpx 24rpx; }

.btn-disabled { background: #ccc; color: #fff; border-radius: 12rpx; }

.report-link {
  text-align: center; color: #999; font-size: 24rpx;
  padding: 24rpx 0 8rpx;
}