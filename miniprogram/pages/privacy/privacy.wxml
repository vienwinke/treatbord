<view class="page">
  <view class="doc-header">
    <view class="doc-title">隐私政策</view>
    <view class="doc-meta">生效日期：{{updatedAt}}</view>
  </view>

  <view class="card" wx:for="{{sections}}" wx:key="title">
    <view class="section-title">{{item.title}}</view>
    <view class="para" wx:for="{{item.paragraphs}}" wx:for-item="p" wx:key="*this">{{p}}</view>
  </view>

  <view class="footer-link" bindtap="openAgreement">查看《用户协议》</view>
  <view class="footer-tip">我们重视您的个人信息保护</view>
</view>