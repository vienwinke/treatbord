# Treatbord 环境变量示例（复制为 .env.local 并填入真实值）
# ⚠️ .env.local 已 gitignore，禁止提交真实密钥

# MySQL（应用账号，最小权限 DML）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=treatbord
MYSQL_USER=app_user
MYSQL_PASSWORD=your_app_password_here

# MySQL（Flyway 迁移账号，含 DDL）
MYSQL_MIGRATE_USER=db_migrate
MYSQL_MIGRATE_PASSWORD=your_migrate_password_here

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# JWT（生产必须 ≥32 字节随机密钥）
JWT_SECRET=

# 微信登录（默认 false 走本地 mock）
WX_LOGIN_ENABLED=false
WX_APPID=
WX_SECRET=

# 内容安全（默认 false 联调关闭）
CONTENT_CHECK_ENABLED=false
