# Treatbord 环境变量示例（复制为 .env.local 并填入真实值）
# ⚠️ .env.local 已 gitignore，禁止提交真实密钥
# 开发环境：只需 MYSQL_* / MYSQL_MIGRATE_*（其余有默认值）
# 生产环境：见「生产必需」标注，缺项会被 StartupValidator 拒绝启动

# ---------- 运行环境 ----------
# dev（默认）/ prod
SPRING_PROFILES_ACTIVE=dev

# ---------- MySQL（应用账号，最小权限 DML）----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=treatbord
MYSQL_USER=app_user
MYSQL_PASSWORD=your_app_password_here

# ---------- MySQL（Flyway 迁移账号，含 DDL）----------
MYSQL_MIGRATE_USER=db_migrate
MYSQL_MIGRATE_PASSWORD=your_migrate_password_here

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=            # 生产建议启用密码

# ---------- JWT（生产必需，≥32 字节随机值）----------
# 生成：openssl rand -base64 48
JWT_SECRET=

# ---------- 密码 pepper（生产必需，禁止开发默认值）----------
PASSWORD_PEPPER=

# ---------- 微信 ----------
# dev: false 走 mock 登录；prod: 必须 true
WX_LOGIN_ENABLED=false
WX_APPID=
WX_SECRET=
# 微信「消息推送」Token（与小程序后台填的同一个值）。为空则内容安全回调一律 503 拒收。
WX_MSG_PUSH_TOKEN=

# ---------- 内容安全 ----------
# dev 建议 false（避免无凭证时调用微信）；prod 强制 true
CONTENT_CHECK_ENABLED=false

# ---------- 文件存储 ----------
# local（默认，开发）| oss（生产）
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_BASE_URL=http://127.0.0.1:8080/files
# 文件签名 URL 密钥（**生产必需**，缺失会被 StartupValidator 拒绝启动）
# 生成：openssl rand -base64 48
STORAGE_SIGN_SECRET=
# 签名 URL 有效期（秒），默认 1800（30 分钟）
# STORAGE_SIGNED_URL_TTL_SECONDS=1800
# 生产使用 OSS 时必需：
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OSS_BUCKET=your-bucket
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=

# ===== AI 问答边车（必填，否则 /api/ai/** 一律 fail-closed）=====
# ⚠️ 这里**故意没有默认值**：同机部署时 127.0.0.1:<treatbord 自己的端口> 会指到 treatbord 自己，
#    表现为"每次问答都 502"，且不会报端口冲突，很难查。启动期会拒绝这种自指配置。
#    同机：http://127.0.0.1:8081（边车默认端口）
#    docker-compose：http://sidecar:8080（服务名，不要写 127.0.0.1）
TREATBORD_AI_SIDECAR_BASE_URL=
