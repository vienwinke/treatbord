# ============================================================
# 生产环境变量模板：复制为 deploy/.env 并填入真实值（.env 已被 .gitignore 忽略）
#   cp deploy/.env.example deploy/.env && ${EDITOR:-vi} deploy/.env
# 生成随机密钥： openssl rand -base64 48
# ============================================================

# ---------- 域名与端口 ----------
DOMAIN=treatbord.example.com
HTTP_PORT=80
HTTPS_PORT=443

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=CHANGE_ME_root
MYSQL_DB=treatbord
MYSQL_USER=app_user
MYSQL_PASSWORD=CHANGE_ME_app
MYSQL_MIGRATE_USER=db_migrate
MYSQL_MIGRATE_PASSWORD=CHANGE_ME_migrate

# ---------- Redis（生产启用密码）----------
REDIS_PASSWORD=CHANGE_ME_redis

# ---------- 安全密钥（必填，禁止默认值）----------
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
PASSWORD_PEPPER=CHANGE_ME_pepper
STORAGE_SIGN_SECRET=CHANGE_ME_sign_secret

# ---------- 微信 ----------
WX_APPID=wx0000000000000000
WX_SECRET=CHANGE_ME_wx_secret

# ---------- 存储 ----------
# local（用容器卷，默认）| oss（对象存储，需下面四项）
STORAGE_TYPE=local
STORAGE_BASE_URL=https://treatbord.example.com/files
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ---------- 反向代理 ----------
# 只有来自这些网段的 X-Forwarded-For 才被信任（否则限流会把所有用户当成同一 IP）
TRUSTED_PROXIES=172.16.0.0/12

# ---------- 运行时 ----------
JAVA_OPTS=-XX:MaxRAMPercentage=70 -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError

# ---------- 备份 ----------
BACKUP_KEEP_DAYS=7
